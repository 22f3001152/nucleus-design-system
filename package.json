{
  "name": "design-system",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "lint:fix": "nx run-many -t lint:fix",
    "lint": "nx run-many -t lint",
    "format": "nx run-many -t format",
    "build": "nx run-many -t build",
    "dev-react": "nx run-many -t dev",
    "storybook": "nx run-many -t storybook",
    "clean:storybook:generated": "rm -rf packages/sb-nucleus-react/storybook-static packages/sb-nucleus-angular/storybook-static packages/sb-nucleus-angular/documentation.json",
    "build-storybook:react": "npm run -w sb-nucleus-react build-storybook",
    "build-storybook:angular": "npm run -w sb-nucleus-angular build-storybook",
    "build-storybook:bundle": "npm run clean:storybook:generated && npm run build-storybook:react && npm run build-storybook:angular",
    "package-storybook:pages": "npm run build-storybook:bundle && node scripts/prepare-pages-bundle.cjs",
    "docs": "nx start nucleus-dev-docs",
    "test": "nx test nucleus",
    "docs:blog": "cd docs && bundle exec jekyll serve",
    "docs:blog:build": "cd docs && bundle exec jekyll build"
  },
  "private": true,
  "engineStrict": true,
  "engines": {
    "npm": ">=10.0.0 <11.0.0",
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.2.21",
    "@biomejs/biome": "1.4.1",
    "@nx/js": "17.1.3",
    "@types/node": "^20.10.1",
    "ng-packagr": "^18.2.1",
    "nx": "17.1.3",
    "typescript": "5.5.4"
  },
  "workspaces": [
    "packages/*"
  ]
}
