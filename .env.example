# Azure Deployment Configuration
# Copy this file to .env and fill in your values
# Note: .env is in .gitignore and will not be committed

# ============================================
# Required for All Deployments
# ============================================

# Azure Resource Group
# The resource group where all infrastructure will be deployed
AZURE_RESOURCE_GROUP=nucleus-design-system

# Azure Environment (dev or prod)
# Determines which parameter files to use (dev.bicepparam or prod.bicepparam)
AZURE_ENV=dev

# ============================================
# Storybook Deployment (Blob Storage)
# ============================================

# Azure Storage Account Name for Storybook
# Must be globally unique, lowercase, 3-24 chars, alphanumeric only
AZURE_STORAGE_ACCOUNT_STORYBOOK=nucleusstorybookdev

# ============================================
# Documentation Deployment (Blob Storage)
# ============================================

# Azure Storage Account Name for Documentation
# Must be globally unique, lowercase, 3-24 chars, alphanumeric only
AZURE_STORAGE_ACCOUNT=nucleusdocsdev

# ============================================
# Local Development (Protected Storybook Server)
# ============================================

# Credentials for local protected Storybook server
# Only used when running: npm run build-and-serve-storybook:bundle:protected
SB_USER=demo
SB_PASS=change-me

# ============================================
# Azure CLI Authentication
# ============================================

# If you prefer to use service principal authentication instead of az login:
# AZURE_SUBSCRIPTION_ID=your-subscription-id
# AZURE_TENANT_ID=your-tenant-id
# AZURE_CLIENT_ID=your-client-id
# AZURE_CLIENT_SECRET=your-client-secret

# ============================================
# Optional Configuration
# ============================================

# Azure Location/Region
# Set in bicepparam files, but can be overridden here
# AZURE_LOCATION=westus

# Enable verbose logging
# DEBUG=true


