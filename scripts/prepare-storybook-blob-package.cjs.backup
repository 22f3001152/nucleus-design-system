#!/usr/bin/env node
const fs = require("node:fs");
const path = require("node:path");
const crypto = require("node:crypto");

const repoRoot = path.resolve(__dirname, "..");
const deployRoot = path.join(repoRoot, ".deploy", "storybook-bundle");

const reactStaticDir = path.join(repoRoot, "packages", "sb-nucleus-react", "storybook-static");
const angularStaticDir = path.join(repoRoot, "packages", "sb-nucleus-angular", "storybook-static");

// Get authentication credentials from environment
const SB_USER = process.env.SB_USER;
const SB_PASS = process.env.SB_PASS;

const ensureExists = (targetPath, message) => {
  if (!fs.existsSync(targetPath)) {
    console.error(message);
    process.exit(1);
  }
};

const copyDir = (source, destination) => {
  fs.mkdirSync(destination, { recursive: true });
  for (const entry of fs.readdirSync(source, { withFileTypes: true })) {
    const src = path.join(source, entry.name);
    const dest = path.join(destination, entry.name);
    if (entry.isDirectory()) {
      copyDir(src, dest);
    } else if (entry.isFile()) {
      fs.copyFileSync(src, dest);
    }
  }
};

// Simple obfuscation (not secure, just basic protection)
const obfuscate = (str) => Buffer.from(str).toString('base64');

console.log('[prepare-storybook-blob] Preparing unified Storybook bundle...\n');

// Check if authentication is enabled
if (!SB_USER || !SB_PASS) {
  console.log('[prepare-storybook-blob] ⚠️  No authentication: SB_USER and SB_PASS not set');
  console.log('[prepare-storybook-blob]    Storybook will be deployed WITHOUT authentication');
  console.log('[prepare-storybook-blob]    To enable auth, set SB_USER and SB_PASS environment variables\n');
}

ensureExists(reactStaticDir, "Missing React storybook-static. Run `npm run build-storybook:react` first.");
ensureExists(angularStaticDir, "Missing Angular storybook-static. Run `npm run build-storybook:angular` first.");

// Clean and create deployment directory
fs.rmSync(deployRoot, { recursive: true, force: true });
fs.mkdirSync(deployRoot, { recursive: true });

// Copy React Storybook as the primary view (root)
console.log('[prepare-storybook-blob] Copying React Storybook (primary)...');
copyDir(reactStaticDir, deployRoot);

// Copy Angular Storybook to /angular subfolder for fallback
console.log('[prepare-storybook-blob] Copying Angular Storybook (linked)...');
copyDir(angularStaticDir, path.join(deployRoot, "angular"));

// Create framework switcher script
console.log('[prepare-storybook-blob] Adding framework switcher...');

const switcherScript = `
(function() {
  'use strict';
  
  // Detect if we're on a docs page
  function isDocsPage() {
    return window.location.pathname.includes('/?path=/docs/');
  }
  
  // Extract component name from URL
  function getComponentFromUrl() {
    const match = window.location.search.match(/path=\\/docs\\/([^&]+)/);
    return match ? match[1] : null;
  }
  
  // Create framework switcher UI
  function createSwitcher() {
    if (!isDocsPage()) return;
    
    const component = getComponentFromUrl();
    if (!component) return;
    
    // Wait for Storybook to load
    const checkAndInject = setInterval(() => {
      const docsContainer = document.querySelector('[class*="DocsPage"]') || 
                           document.querySelector('#storybook-docs') ||
                           document.querySelector('main');
      
      if (docsContainer && !document.getElementById('framework-switcher')) {
        clearInterval(checkAndInject);
        
        const switcher = document.createElement('div');
        switcher.id = 'framework-switcher';
        switcher.style.cssText = \`
          position: fixed;
          top: 60px;
          right: 20px;
          z-index: 999999;
          background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
          color: white;
          padding: 12px 20px;
          border-radius: 8px;
          box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
          font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
          font-size: 14px;
          font-weight: 600;
          cursor: pointer;
          transition: transform 0.2s, box-shadow 0.2s;
          display: flex;
          align-items: center;
          gap: 8px;
        \`;
        
        switcher.innerHTML = \`
          <span>📱</span>
          <span>Switch to Angular</span>
        \`;
        
        switcher.addEventListener('mouseover', () => {
          switcher.style.transform = 'translateY(-2px)';
          switcher.style.boxShadow = '0 6px 20px rgba(0, 0, 0, 0.3)';
        });
        
        switcher.addEventListener('mouseout', () => {
          switcher.style.transform = 'translateY(0)';
          switcher.style.boxShadow = '0 4px 16px rgba(0, 0, 0, 0.2)';
        });
        
        switcher.addEventListener('click', () => {
          const angularUrl = '/angular/' + window.location.search;
          window.location.href = angularUrl;
        });
        
        document.body.appendChild(switcher);
      }
    }, 500);
    
    // Clear interval after 10 seconds to avoid infinite checking
    setTimeout(() => clearInterval(checkAndInject), 10000);
  }
  
  // Initialize
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', createSwitcher);
  } else {
    createSwitcher();
  }
  
  // Also listen for URL changes (for SPA navigation)
  let lastUrl = location.href;
  new MutationObserver(() => {
    const url = location.href;
    if (url !== lastUrl) {
      lastUrl = url;
      createSwitcher();
    }
  }).observe(document, {subtree: true, childList: true});
  
})();
`;

const switcherScriptAngular = `
(function() {
  'use strict';
  
  // Detect if we're on a docs page
  function isDocsPage() {
    return window.location.pathname.includes('/?path=/docs/') || 
           window.location.search.includes('path=/docs/');
  }
  
  // Extract component name from URL
  function getComponentFromUrl() {
    const match = window.location.search.match(/path=\\/docs\\/([^&]+)/);
    return match ? match[1] : null;
  }
  
  // Create framework switcher UI
  function createSwitcher() {
    if (!isDocsPage()) return;
    
    const component = getComponentFromUrl();
    if (!component) return;
    
    // Wait for Storybook to load
    const checkAndInject = setInterval(() => {
      const docsContainer = document.querySelector('[class*="DocsPage"]') || 
                           document.querySelector('#storybook-docs') ||
                           document.querySelector('main');
      
      if (docsContainer && !document.getElementById('framework-switcher')) {
        clearInterval(checkAndInject);
        
        const switcher = document.createElement('div');
        switcher.id = 'framework-switcher';
        switcher.style.cssText = \`
          position: fixed;
          top: 60px;
          right: 20px;
          z-index: 999999;
          background: linear-gradient(135deg, #61dafb 0%, #21a1c4 100%);
          color: #282c34;
          padding: 12px 20px;
          border-radius: 8px;
          box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
          font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
          font-size: 14px;
          font-weight: 600;
          cursor: pointer;
          transition: transform 0.2s, box-shadow 0.2s;
          display: flex;
          align-items: center;
          gap: 8px;
        \`;
        
        switcher.innerHTML = \`
          <span>⚛️</span>
          <span>Switch to React</span>
        \`;
        
        switcher.addEventListener('mouseover', () => {
          switcher.style.transform = 'translateY(-2px)';
          switcher.style.boxShadow = '0 6px 20px rgba(0, 0, 0, 0.3)';
        });
        
        switcher.addEventListener('mouseout', () => {
          switcher.style.transform = 'translateY(0)';
          switcher.style.boxShadow = '0 4px 16px rgba(0, 0, 0, 0.2)';
        });
        
        switcher.addEventListener('click', () => {
          // Go back to root (React) with same component
          const reactUrl = '/' + window.location.search;
          window.location.href = reactUrl;
        });
        
        document.body.appendChild(switcher);
      }
    }, 500);
    
    // Clear interval after 10 seconds to avoid infinite checking
    setTimeout(() => clearInterval(checkAndInject), 10000);
  }
  
  // Initialize
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', createSwitcher);
  } else {
    createSwitcher();
  }
  
  // Also listen for URL changes (for SPA navigation)
  let lastUrl = location.href;
  new MutationObserver(() => {
    const url = location.href;
    if (url !== lastUrl) {
      lastUrl = url;
      createSwitcher();
    }
  }).observe(document, {subtree: true, childList: true});
  
})();
`;

// Save switcher scripts
fs.writeFileSync(path.join(deployRoot, "framework-switcher.js"), switcherScript.trim());
fs.writeFileSync(path.join(deployRoot, "angular", "framework-switcher.js"), switcherScriptAngular.trim());

// Inject switcher into React Storybook index.html
const reactIndexPath = path.join(deployRoot, "index.html");
if (fs.existsSync(reactIndexPath)) {
  let reactIndex = fs.readFileSync(reactIndexPath, 'utf8');
  const switcherTag = '<script src="/framework-switcher.js"></script>';
  reactIndex = reactIndex.replace('</head>', `${switcherTag}</head>`);
  fs.writeFileSync(reactIndexPath, reactIndex);
}

// Inject switcher into Angular Storybook index.html
const angularIndexPath = path.join(deployRoot, "angular", "index.html");
if (fs.existsSync(angularIndexPath)) {
  let angularIndex = fs.readFileSync(angularIndexPath, 'utf8');
  const switcherTag = '<script src="/angular/framework-switcher.js"></script>';
  angularIndex = angularIndex.replace('</head>', `${switcherTag}</head>`);
  fs.writeFileSync(angularIndexPath, angularIndex);
}

console.log('[prepare-storybook-blob] ✅ Framework switcher added');
console.log('[prepare-storybook-blob]    React (primary) with Angular toggle\n');

// Add authentication wrapper if credentials are provided
if (SB_USER && SB_PASS) {
  console.log('[prepare-storybook-blob] 🔐 Adding authentication layer...');
  
  // Create auth.js - authentication library
  const authJs = `
// Simple client-side authentication
(function() {
  const AUTH_KEY = 'sb_auth_token';
  const CREDENTIALS = {
    username: atob('${obfuscate(SB_USER)}'),
    password: atob('${obfuscate(SB_PASS)}')
  };

  window.SBAuth = {
    isAuthenticated: function() {
      const token = sessionStorage.getItem(AUTH_KEY);
      if (!token) return false;
      
      try {
        const data = JSON.parse(atob(token));
        return data.user === CREDENTIALS.username && 
               data.timestamp > Date.now() - (12 * 60 * 60 * 1000); // 12 hours
      } catch {
        return false;
      }
    },
    
    authenticate: function(username, password) {
      if (username === CREDENTIALS.username && password === CREDENTIALS.password) {
        const token = btoa(JSON.stringify({
          user: username,
          timestamp: Date.now()
        }));
        sessionStorage.setItem(AUTH_KEY, token);
        return true;
      }
      return false;
    },
    
    logout: function() {
      sessionStorage.removeItem(AUTH_KEY);
      window.location.href = '/login.html';
    },
    
    requireAuth: function() {
      if (!this.isAuthenticated()) {
        const returnUrl = encodeURIComponent(window.location.pathname + window.location.search);
        window.location.href = '/login.html?return=' + returnUrl;
      }
    }
  };
})();
`;

  fs.writeFileSync(path.join(deployRoot, "auth.js"), authJs.trim());

  // Create login.html
  const loginHtml = `<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - Nucleus Storybook</title>
    <script src="/auth.js"></script>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        }
        .login-container {
            background: white;
            padding: 2.5rem;
            border-radius: 16px;
            box-shadow: 0 8px 32px rgba(31, 38, 135, 0.37);
            width: 100%;
            max-width: 400px;
        }
        h1 { color: #333; margin-bottom: 0.5rem; font-size: 1.75rem; }
        .subtitle { color: #666; margin-bottom: 2rem; font-size: 0.95rem; }
        .form-group { margin-bottom: 1.5rem; }
        label {
            display: block;
            margin-bottom: 0.5rem;
            color: #333;
            font-weight: 500;
            font-size: 0.9rem;
        }
        input {
            width: 100%;
            padding: 0.75rem;
            border: 2px solid #e0e0e0;
            border-radius: 8px;
            font-size: 1rem;
            transition: border-color 0.2s;
        }
        input:focus { outline: none; border-color: #667eea; }
        button {
            width: 100%;
            padding: 0.875rem;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border: none;
            border-radius: 8px;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            transition: transform 0.2s, box-shadow 0.2s;
        }
        button:hover:not(:disabled) {
            transform: translateY(-2px);
            box-shadow: 0 4px 16px rgba(102, 126, 234, 0.4);
        }
        button:disabled { opacity: 0.6; cursor: not-allowed; }
        .error {
            color: #dc3545;
            margin-top: 1rem;
            text-align: center;
            font-size: 0.9rem;
        }
        .logo { text-align: center; margin-bottom: 2rem; font-size: 3rem; }
    </style>
</head>
<body>
    <div class="login-container">
        <div class="logo">🎨</div>
        <h1>Nucleus Storybook</h1>
        <p class="subtitle">Sign in to access the design system documentation</p>
        <form id="loginForm">
            <div class="form-group">
                <label for="username">Username</label>
                <input type="text" id="username" required autocomplete="username" autofocus>
            </div>
            <div class="form-group">
                <label for="password">Password</label>
                <input type="password" id="password" required autocomplete="current-password">
            </div>
            <button type="submit">Sign In</button>
            <div id="error" class="error" style="display: none;"></div>
        </form>
    </div>
    <script>
        if (SBAuth.isAuthenticated()) {
            const params = new URLSearchParams(window.location.search);
            window.location.href = params.get('return') || '/';
        }
        document.getElementById('loginForm').addEventListener('submit', function(e) {
            e.preventDefault();
            const username = document.getElementById('username').value;
            const password = document.getElementById('password').value;
            const errorDiv = document.getElementById('error');
            const submitBtn = e.target.querySelector('button[type="submit"]');
            submitBtn.disabled = true;
            errorDiv.style.display = 'none';
            setTimeout(() => {
                if (SBAuth.authenticate(username, password)) {
                    const params = new URLSearchParams(window.location.search);
                    window.location.href = params.get('return') || '/';
                } else {
                    errorDiv.textContent = 'Invalid username or password';
                    errorDiv.style.display = 'block';
                    submitBtn.disabled = false;
                    document.getElementById('password').value = '';
                    document.getElementById('password').focus();
                }
            }, 300);
        });
    </script>
</body>
</html>
`;

  fs.writeFileSync(path.join(deployRoot, "login.html"), loginHtml.trim());

  // Add auth check to React Storybook (root) index.html
  if (fs.existsSync(reactIndexPath)) {
    let reactIndex = fs.readFileSync(reactIndexPath, 'utf8');
    const authScript = `<script src="/auth.js"></script><script>SBAuth.requireAuth();</script>`;
    // Make sure we don't add it twice
    if (!reactIndex.includes('auth.js')) {
      reactIndex = reactIndex.replace('<script src="/framework-switcher.js"></script></head>', 
                                       `${authScript}<script src="/framework-switcher.js"></script></head>`);
      fs.writeFileSync(reactIndexPath, reactIndex);
    }
  }

  // Add auth check to Angular Storybook index.html
  if (fs.existsSync(angularIndexPath)) {
    let angularIndex = fs.readFileSync(angularIndexPath, 'utf8');
    const authScript = `<script src="/auth.js"></script><script>SBAuth.requireAuth();</script>`;
    // Make sure we don't add it twice
    if (!angularIndex.includes('auth.js')) {
      angularIndex = angularIndex.replace('<script src="/angular/framework-switcher.js"></script></head>', 
                                          `${authScript}<script src="/angular/framework-switcher.js"></script></head>`);
      fs.writeFileSync(angularIndexPath, angularIndex);
    }
  }

  console.log('[prepare-storybook-blob] ✅ Authentication enabled');
  console.log('[prepare-storybook-blob]    Username: ' + SB_USER);
  console.log('[prepare-storybook-blob]    Session: 12 hours\n');
}

console.log('\n[prepare-storybook-blob] ✅ Unified Storybook bundle prepared successfully!');
console.log(`[prepare-storybook-blob] 📦 Location: ${deployRoot}`);
console.log('[prepare-storybook-blob] 📂 Structure:');
console.log('[prepare-storybook-blob]    / (React Storybook - primary)');
console.log('[prepare-storybook-blob]    /framework-switcher.js (React → Angular toggle)');
if (SB_USER && SB_PASS) {
  console.log('[prepare-storybook-blob]    /login.html (authentication)');
  console.log('[prepare-storybook-blob]    /auth.js (auth library)');
}
console.log('[prepare-storybook-blob]    /angular/ (Angular Storybook - linked)');
console.log('[prepare-storybook-blob]    /angular/framework-switcher.js (Angular → React toggle)');
console.log('[prepare-storybook-blob] \n✨ Users can toggle between React and Angular on any component page!');
console.log('[prepare-storybook-blob] \nReady for deployment to Azure Blob Storage!\n');

