{
  "name": "sb-nucleus-angular",
  "version": "0.2.0",
  "description": "Starter template to get up and running quickly with Angular and Storybook",
  "author": "Chromatic <https://chromatic.com/>",
  "repository": {
    "type": "git",
    "url": "https://github.com/chromaui/intro-storybook-angular-template"
  },
  "bugs": {
    "url": "https://github.com/chromaui/intro-storybook-angular-template/issues"
  },
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "dev": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "jest --no-cache",
    "storybook": "ng run sb-nucleus-angular:storybook",
    "build-storybook": "ng run sb-nucleus-angular:build-storybook",
    "lint": "biome lint \"src\"",
    "lint:fix": "biome check --apply \"src\"",
    "format": "biome format \"src\" --write"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^18.2.14",
    "@angular/common": "^18.2.14",
    "@angular/compiler": "^18.2.14",
    "@angular/core": "^18.2.14",
    "@angular/forms": "^18.2.14",
    "@angular/platform-browser": "^18.2.14",
    "@angular/platform-browser-dynamic": "^18.2.14",
    "@angular/router": "^18.2.14",
    "nucleus-angular": "*",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.2.21",
    "@angular/cli": "^18.2.21",
    "@angular/compiler-cli": "^18.2.14",
    "@compodoc/compodoc": "^1.1.19",
    "@storybook/addon-docs": "^10.3.1",
    "@storybook/addon-links": "^10.3.1",
    "@storybook/angular": "^10.3.1",
    "@types/jest": "^29.5.1",
    "jest": "^29.5.0",
    "jest-preset-angular": "^15.0.3",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "~2.2.0",
    "msw": "^1.2.1",
    "msw-storybook-addon": "^1.10.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "storybook": "^10.3.1",
    "storybook-addon-rtl": "^3.0.1",
    "typescript": "5.5.4"
  }
}
